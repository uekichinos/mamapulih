{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vue-tsc && vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --check resources/js",
        "format:fix": "prettier --write resources/js",
        "typecheck": "vue-tsc --noEmit",
        "i18n:check": "node scripts/check-i18n.mjs",
        "test": "cross-env LARAVEL_BYPASS_ENV_CHECK=1 vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^3.9.1",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.5.31",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue": "^3.4.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "overrides": {
        "minimatch": "^11.0.1",
        "glob": "^14.0.3"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "vue-i18n": "^11.4.16"
    }
}
